<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- ==========[Mashed_Ashlands_Guar]========== -->
	<ThingDef ParentName="Mashed_Ashlands_GuarThingBase">
		<defName>Mashed_Ashlands_GuarGlowing</defName>
		<label>glowing guar</label>
		<description>A subspecies of the common guar that has adapted to life in polluted regions. Their highly modified respiratory system allows glowing guar to absorb nutrients from environmental pollution. Excess toxins are released in their saliva, causing it to become highly acidic.\n\n&lt;color=#E5E54C&gt;Acidic saliva&lt;/color&gt;\nBites from a glowing guar may inflict acid burns.\n\n&lt;color=#E5E54C&gt;Pollution Absorption&lt;/color&gt;\nGlowing guar can absorb nutrients from environmental pollution, decreasing their hunger fall rate.</description>
		<modExtensions>
			<li Class="Mashed_Ashlands.AnimalProperties">
				<glowOverlay>true</glowOverlay>
			</li>
			<li Class="Mashed_Ashlands.PollutionProperties">
				<alternativePollutionStimulis>Mashed_Ashlands_PollutionAbsorption</alternativePollutionStimulis>
			</li>
		</modExtensions>
		<statBases>
			<MarketValue>350</MarketValue>
			<ToxicResistance>1</ToxicResistance>
			<ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1</ToxicEnvironmentResistance>
			<Wildness>0.6</Wildness>
		</statBases>
		<comps>
			<li Class="CompProperties_EggLayer">
				<eggFertilizedDef>Mashed_Ashlands_Egg_GuarGlowingFertilized</eggFertilizedDef>
				<eggUnfertilizedDef>Mashed_Ashlands_Egg_GuarGlowingUnfertilized</eggUnfertilizedDef>
				<eggFertilizationCountMax>1</eggFertilizationCountMax>
				<eggLayIntervalDays>3.3</eggLayIntervalDays>
				<eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
				<eggCountRange>1</eggCountRange>
			</li>
		</comps>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.5</chanceFactor>
				<extraMeleeDamages>
					<li>
						<def>AcidBurn</def>
						<amount>5</amount>
						<chance>0.8</chance>
					</li>
				</extraMeleeDamages>
			</li>
		</tools>
		<race>
			<bloodDef>Mashed_Ashlands_Filth_GlowingBlood</bloodDef>
			<useMeatFrom>Mashed_Ashlands_Guar</useMeatFrom>
		</race>
		<tradeTags>
			<li>Mashed_Ashlands_AshlandAnimalGlowing</li>
		</tradeTags>
	</ThingDef>
