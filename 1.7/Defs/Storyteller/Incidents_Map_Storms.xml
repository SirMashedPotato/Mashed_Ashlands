<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- ==========[Mashed_Ashlands_VolcanolessMapConditionBase]==========-->
	<IncidentDef ParentName="Mashed_Ashlands_AshlandsMapIncident" Name="Mashed_Ashlands_VolcanolessMapConditionBase" Abstract="True">
		<letterDef>Mashed_Ashlands_VolcanoNegativeEvent</letterDef>
		<category>Misc</category>
		<workerClass>Mashed_Ashlands.IncidentWorker_MakeGameConditionVolcanoless</workerClass>
		<disabledWhen>
			<extremeWeatherIncidentsDisabled>true</extremeWeatherIncidentsDisabled>
		</disabledWhen>
		<allowedBiomes>
			<!-- Blighted -->
			<li>Mashed_Ashlands_BlightedAshlands</li>
			<li>Mashed_Ashlands_BlightedBogAshlands</li>
			<li>Mashed_Ashlands_BlightedPetrifiedForestAshlands</li>
			<!-- Regular -->
			<li>Mashed_Ashlands_Ashlands</li>
			<li>Mashed_Ashlands_DustplainAshlands</li>
			<li>Mashed_Ashlands_GrazelandAshlands</li>
			<li>Mashed_Ashlands_HighlandAshlands</li>
			<li>Mashed_Ashlands_SwampAshlands</li>
			<!-- Volcanic -->
			<li>Mashed_Ashlands_VolcanicAshlands</li>
			<li>Mashed_Ashlands_VolcanicBadlandAshlands</li>
			<li>Mashed_Ashlands_VolcanicBasaltHillsAshlands</li>
			<li>Mashed_Ashlands_VolcanicGroveAshlands</li>
			<li>Mashed_Ashlands_VolcanicSulphurPitsAshlands</li>
		</allowedBiomes>
	</IncidentDef>
	<!-- ==========[Mashed_Ashlands_VolcanolessAshStorm]==========-->
	<IncidentDef ParentName="Mashed_Ashlands_VolcanolessMapConditionBase">
		<defName>Mashed_Ashlands_VolcanolessAshStorm</defName>
		<label>ash storm</label>
		<gameCondition>Mashed_Ashlands_AshStorm</gameCondition>
		<letterLabel>Ash storm</letterLabel>
		<baseChance>0.12</baseChance>
		<earliestDay>30</earliestDay>
		<minRefireDays>30</minRefireDays>
		<durationDays>1~5</durationDays>
	</IncidentDef>
