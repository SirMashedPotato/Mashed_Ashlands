<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Cooking Expanded - Sushi</li> <!-- TODO ADD CRAB MEAT -->
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!-- ==========[Abstract defs]==========-->
				<li Class="PatchOperationAdd">
					<xpath>Defs/RecipeDef[
						@Name="VCE_CookSushiMealBase" or @Name="VCE_CookFineSushiMealBase" or @Name="VCE_CookGourmetSushiMealBase"
						]/fixedIngredientFilter/thingDefs</xpath>
					<value>
						<li>Mashed_Ashlands_RawSaltrice</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/RecipeDef[
						@Name="VCE_CookSushiMealBase" or @Name="VCE_CookFineSushiMealBase" or @Name="VCE_CookGourmetSushiMealBase"
						]/defaultIngredientFilter/thingDefs</xpath>
					<value>
						<li>Mashed_Ashlands_RawSaltrice</li>
					</value>
				</li>
				<!-- ==========[Specific defs]==========-->
				<li Class="PatchOperationAdd">
					<xpath>Defs/RecipeDef[
						defName="VCE_CookSushi_Simple" or  defName="VCE_CookSushi_Simple_Bulk" or
						defName="VCE_CookSushi_Fine" or  defName="VCE_CookSushi_Fine_Bulk" or
						defName="VCE_CookSushi_Lavish" or  defName="VCE_CookSushi_Lavish_Bulk" or
						defName="VCE_CookSushi_Gourmet"
						]/ingredients/li/filter/thingDefs[li="RawRice"]</xpath>
					<value>
						<li>Mashed_Ashlands_RawSaltrice</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
